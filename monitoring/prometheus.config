# ============================================================
# prometheus.config - Konfigurasi Prometheus
# Proyek Akhir MLOps - sonnyariady
#
# File ini digunakan oleh Dockerfile pada direktori monitoring
# dan disalin menjadi /etc/prometheus/prometheus.yml.
# Isinya identik dengan prometheus.yml (disediakan keduanya
# sesuai ketentuan submission).
# ============================================================

global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: "ml-serving-app"
    metrics_path: /metrics
    static_configs:
      - targets: ["app:8080", "host.docker.internal:8080"]
        labels:
          application: "abalone-mlops"